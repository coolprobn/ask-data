- content_for :title, "Customers"

h1.text-2xl.font-semibold.mb-4 Customers
.overflow-x-auto
  table.min-w-full.border.border-gray-200.text-sm
    thead.bg-gray-50
      tr
        th.border-b.border-gray-200.px-3.py-2.text-left ID
        th.border-b.border-gray-200.px-3.py-2.text-left Name
        th.border-b.border-gray-200.px-3.py-2.text-left Email
        th.border-b.border-gray-200.px-3.py-2.text-left Created
    tbody
      - @customers.each do |c|
        tr.hover:bg-gray-50
          td.border-t.border-gray-100.px-3.py-2= c.id
          td.border-t.border-gray-100.px-3.py-2= c.name
          td.border-t.border-gray-100.px-3.py-2= c.email
          td.border-t.border-gray-100.px-3.py-2.whitespace-nowrap= l(c.created_at, format: :short)
